<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />
    <!-- OpenTelemetry for the demo: traces, metrics (ResultUnion's included) and logs over OTLP, e.g. to the Aspire Dashboard. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion.AspNetCore\ResultUnion.AspNetCore.csproj" />
    <ProjectReference Include="..\ResultUnion.Samples.Domain\ResultUnion.Samples.Domain.csproj" />
    <ProjectReference Include="..\ResultUnion.Samples.Application\ResultUnion.Samples.Application.csproj" />
  </ItemGroup>

</Project>
