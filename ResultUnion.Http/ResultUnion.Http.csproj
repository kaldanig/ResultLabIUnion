<Project Sdk="Microsoft.NET.Sdk">

  <!-- HTTP client integration: a response, or a problem details body, read back as a Result / Error. No ASP.NET Core. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>HTTP client integration for ResultUnion: HttpResponseMessage.ReadResultAsync turns a response into a Result, and an RFC 9457 problem details body (code, category, arguments, field errors) back into an Error, the reverse of ResultUnion.AspNetCore.</Description>
    <PackageTags>result;result-pattern;http;httpclient;problem-details;rfc9457</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": a project that installs only this package still gets the ResultUnion analyzers. -->
    <ProjectReference Include="..\ResultUnion\ResultUnion.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
