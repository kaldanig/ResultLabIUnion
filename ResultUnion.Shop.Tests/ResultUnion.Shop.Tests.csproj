<Project Sdk="Microsoft.NET.Sdk">

  <!-- Both services of the shop sample in memory, wired together: the orders service's HTTP client goes to the
       inventory service's test server, so a reservation, a missing product or an unreachable inventory travels between
       them as it does in production. Each service has a Program class, hence the aliases. -->

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion.Shop.Orders\ResultUnion.Shop.Orders.csproj" Aliases="orders" />
    <ProjectReference Include="..\ResultUnion.Shop.Inventory\ResultUnion.Shop.Inventory.csproj" Aliases="inventory" />
    <ProjectReference Include="..\ResultUnion.Shop.Web\ResultUnion.Shop.Web.csproj" Aliases="web" />
  </ItemGroup>

</Project>
