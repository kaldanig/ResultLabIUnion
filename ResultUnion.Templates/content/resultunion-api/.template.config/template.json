{
  "$schema": "http://json.schemastore.org/template",
  "author": "Giorgi Kaldani",
  "classifications": [ "Web", "WebAPI", "Result pattern" ],
  "identity": "ResultUnion.Templates.WebApi",
  "name": "ResultUnion Web API",
  "description": "A Minimal API that uses the Result pattern with ResultUnion: a feature with value objects and error catalogs, a use case as one pipeline, endpoints that turn failures into problem responses, and tests with ResultUnion.Testing.",
  "shortName": "resultunion-api",
  "sourceName": "ResultUnionApi",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "NoTests": {
      "type": "parameter",
      "displayName": "Leave out the test project",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Leave out the test project."
    },
    "Tests": {
      "type": "computed",
      "value": "(!NoTests)"
    },
    "Database": {
      "type": "parameter",
      "displayName": "Database",
      "datatype": "choice",
      "defaultValue": "inmemory",
      "description": "Where the products are stored.",
      "choices": [
        { "choice": "inmemory", "description": "In memory: nothing to set up, gone when the application stops." },
        { "choice": "sqlite", "description": "SQLite through EF Core, with a unique index on the name." }
      ]
    },
    "Sqlite": {
      "type": "computed",
      "value": "(Database == \"sqlite\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(NoTests)",
          "exclude": [ "tests/**" ]
        },
        {
          "condition": "(!Sqlite)",
          "exclude": [ "src/ResultUnionApi/Data/**", "src/ResultUnionApi/Products/EfProductRepository.cs" ]
        }
      ]
    }
  ]
}
