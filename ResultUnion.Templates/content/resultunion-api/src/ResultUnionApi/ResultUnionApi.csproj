<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings ResultUnion itself and its analyzers. -->
    <PackageReference Include="ResultUnion.AspNetCore" Version="RESULTUNION_VERSION" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
<!--#if (Sqlite)-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
<!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <Using Include="ResultUnion" />
  </ItemGroup>

</Project>
