{
  "$schema": "http://json.schemastore.org/template",
  "author": "Giorgi Kaldani",
  "classifications": [
    "Web",
    "WebAPI",
    "gRPC",
    "Code",
    "Result pattern"
  ],
  "identity": "ResultUnion.Templates.Feature",
  "name": "ResultUnion feature",
  "description": "A feature in the shape of the templates' products: an entity and a value object with error catalogs, a repository, a service whose use cases are Result pipelines, and Minimal API endpoints that return problem responses, or with --grpc a gRPC service whose failures become rich statuses.",
  "shortName": "resultunion-feature",
  "sourceName": "Widget",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "displayName": "Namespace",
      "datatype": "text",
      "description": "The namespace the feature's folder goes under. By default the project's root namespace."
    },
    "RootNamespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "defaultValue": "MyApp"
    },
    "TargetNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Namespace",
        "fallbackVariableName": "RootNamespace"
      },
      "replaces": "TargetNamespace"
    },
    "Plural": {
      "type": "parameter",
      "displayName": "Plural",
      "datatype": "text",
      "description": "The plural of the name, for the folder, the namespace, the route and the metrics. By default the name with an s."
    },
    "DefaultPlural": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "addS"
    },
    "PluralName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Plural",
        "fallbackVariableName": "DefaultPlural"
      },
      "replaces": "Gizmos",
      "fileRename": "Gizmos"
    },
    "EntityCode": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "snakeCase",
      "replaces": "ENTITY_CODE"
    },
    "EntityWords": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "words",
      "replaces": "ENTITY_WORDS"
    },
    "PluralCode": {
      "type": "derived",
      "valueSource": "PluralName",
      "valueTransform": "snakeCase",
      "replaces": "PLURAL_CODE",
      "fileRename": "PLURAL_CODE"
    },
    "PluralRoute": {
      "type": "derived",
      "valueSource": "PluralName",
      "valueTransform": "kebab",
      "replaces": "PLURAL_ROUTE"
    },
    "PluralWords": {
      "type": "derived",
      "valueSource": "PluralName",
      "valueTransform": "words",
      "replaces": "ENTITY_PLURAL_WORDS"
    },
    "Database": {
      "type": "parameter",
      "displayName": "Database",
      "datatype": "choice",
      "defaultValue": "inmemory",
      "description": "Where the entities are stored.",
      "choices": [
        {
          "choice": "inmemory",
          "description": "In memory: nothing to set up, gone when the application stops."
        },
        {
          "choice": "sqlite",
          "description": "SQLite through EF Core, in the application's DbContext, with a unique index on the name."
        }
      ]
    },
    "Sqlite": {
      "type": "computed",
      "value": "(Database == \"sqlite\")"
    },
    "Crud": {
      "type": "parameter",
      "displayName": "Update and delete",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Also rename and delete, with a version that keeps two clients from overwriting each other (409 changed_concurrently)."
    },
    "Grpc": {
      "type": "parameter",
      "displayName": "gRPC",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "A gRPC service and its .proto contract instead of Minimal API endpoints, for a project made with resultunion-grpc."
    }
  },
  "forms": {
    "addS": {
      "identifier": "replace",
      "pattern": "$",
      "replacement": "s"
    },
    "kebab": {
      "identifier": "kebabCase"
    },
    "dashToUnderscore": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "_"
    },
    "dashToSpace": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": " "
    },
    "snakeCase": {
      "identifier": "chain",
      "steps": [
        "kebab",
        "dashToUnderscore"
      ]
    },
    "words": {
      "identifier": "chain",
      "steps": [
        "kebab",
        "dashToSpace"
      ]
    }
  },
  "postActions": [
    {
      "condition": "(!Sqlite && !Grpc)",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Register the feature in Program.cs.",
      "manualInstructions": [
        {
          "text": "Call the two methods of the new ...Feature class in Program.cs: builder.Services.Add<Plural>() and app.Map<Plural>()."
        }
      ],
      "continueOnError": true
    },
    {
      "condition": "(Sqlite && !Grpc)",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Register the feature in Program.cs and its entity in the DbContext.",
      "manualInstructions": [
        {
          "text": "Call builder.Services.Add<Plural><AppDbContext>() and app.Map<Plural>() in Program.cs, and modelBuilder.ApplyConfiguration(new ...Configuration()) in the DbContext's OnModelCreating."
        }
      ],
      "continueOnError": true
    },
    {
      "condition": "(Grpc)",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Register the feature in Program.cs; the contract is in Protos/.",
      "manualInstructions": [
        {
          "text": "Call builder.Services.Add<Plural>() (Add<Plural><AppDbContext>() with --database sqlite, and apply the ...Configuration in OnModelCreating) and app.Map<Plural>() in Program.cs. The contract is Protos/<plural>.proto: resultunion-grpc compiles every file in Protos/; another project needs a Protobuf item for it."
        }
      ],
      "continueOnError": true
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!Sqlite)",
          "exclude": [
            "Gizmos/EfWidgetRepository.cs",
            "Gizmos/WidgetConfiguration.cs"
          ]
        },
        {
          "condition": "(!Grpc)",
          "exclude": [
            "Grpc/**"
          ]
        },
        {
          "condition": "(Grpc && !Crud)",
          "exclude": [
            "Gizmos/WidgetFeature.cs",
            "Grpc/PLURAL_CODE.crud.proto"
          ],
          "rename": {
            "Grpc/WidgetFeature.cs": "Gizmos/WidgetFeature.cs",
            "Grpc/WidgetCatalogService.cs": "Gizmos/WidgetCatalogService.cs",
            "Grpc/PLURAL_CODE.proto": "Protos/PLURAL_CODE.proto"
          }
        },
        {
          "condition": "(Grpc && Crud)",
          "exclude": [
            "Gizmos/WidgetFeature.cs",
            "Grpc/PLURAL_CODE.proto"
          ],
          "rename": {
            "Grpc/WidgetFeature.cs": "Gizmos/WidgetFeature.cs",
            "Grpc/WidgetCatalogService.cs": "Gizmos/WidgetCatalogService.cs",
            "Grpc/PLURAL_CODE.crud.proto": "Protos/PLURAL_CODE.proto"
          }
        }
      ]
    }
  ]
}
