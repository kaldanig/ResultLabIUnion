<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server base class for the service and the client for the tests (and for other .NET callers). -->
    <Protobuf Include="Protos\products.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings ResultUnion itself and its analyzers. -->
    <PackageReference Include="ResultUnion.Grpc" Version="RESULTUNION_VERSION" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.85.0" />
<!--#if (Sqlite)-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
<!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <Using Include="ResultUnion" />
  </ItemGroup>

</Project>
