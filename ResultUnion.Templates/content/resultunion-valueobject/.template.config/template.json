{
  "$schema": "http://json.schemastore.org/template",
  "author": "Giorgi Kaldani",
  "classifications": [
    "Code",
    "Result pattern"
  ],
  "identity": "ResultUnion.Templates.ValueObject",
  "name": "ResultUnion value object",
  "description": "A value object with its error catalog: Create returns Result<T>, the codes are declared once, and the arguments are in the errors for clients that translate them. A string with a maximum length, or an int or decimal with a range.",
  "shortName": "resultunion-valueobject",
  "sourceName": "ValueName",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "displayName": "Namespace",
      "datatype": "text",
      "description": "The namespace of the value object. By default the project's root namespace."
    },
    "RootNamespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "defaultValue": "MyApp"
    },
    "TargetNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Namespace",
        "fallbackVariableName": "RootNamespace"
      },
      "replaces": "TargetNamespace"
    },
    "ValueType": {
      "type": "parameter",
      "displayName": "Value type",
      "datatype": "choice",
      "defaultValue": "string",
      "description": "What the value object holds.",
      "replaces": "VALUE_TYPE",
      "choices": [
        {
          "choice": "string",
          "description": "A string: required, trimmed, at most --max-length characters."
        },
        {
          "choice": "int",
          "description": "An int from --min to --max."
        },
        {
          "choice": "decimal",
          "description": "A decimal from --min to --max."
        }
      ]
    },
    "IsString": {
      "type": "computed",
      "value": "(ValueType == \"string\")"
    },
    "IsDecimal": {
      "type": "computed",
      "value": "(ValueType == \"decimal\")"
    },
    "MaxLength": {
      "type": "parameter",
      "displayName": "Maximum length",
      "datatype": "integer",
      "defaultValue": "100",
      "description": "The most characters a string value may have.",
      "replaces": "VALUE_MAX_LENGTH"
    },
    "Min": {
      "type": "parameter",
      "displayName": "Minimum",
      "datatype": "text",
      "defaultValue": "1",
      "description": "The smallest int or decimal value allowed, a C# number such as 1 or 0.01.",
      "replaces": "VALUE_LOWEST"
    },
    "Max": {
      "type": "parameter",
      "displayName": "Maximum",
      "datatype": "text",
      "defaultValue": "1000",
      "description": "The largest int or decimal value allowed.",
      "replaces": "VALUE_HIGHEST"
    },
    "Code": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "snakeCase",
      "replaces": "VALUE_CODE"
    },
    "Words": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "words",
      "replaces": "VALUE_WORDS"
    }
  },
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    },
    "dashToUnderscore": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "_"
    },
    "dashToSpace": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": " "
    },
    "snakeCase": {
      "identifier": "chain",
      "steps": [
        "kebab",
        "dashToUnderscore"
      ]
    },
    "words": {
      "identifier": "chain",
      "steps": [
        "kebab",
        "dashToSpace"
      ]
    }
  }
}
