{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "ResultUnion/bin/Release/net11.0/ResultUnion.dll",
            "ResultUnion.AspNetCore/bin/Release/net11.0/ResultUnion.AspNetCore.dll",
            "ResultUnion.Grpc/bin/Release/net11.0/ResultUnion.Grpc.dll",
            "ResultUnion.FluentValidation/bin/Release/net11.0/ResultUnion.FluentValidation.dll",
            "ResultUnion.Http/bin/Release/net11.0/ResultUnion.Http.dll",
            "ResultUnion.Testing/bin/Release/net11.0/ResultUnion.Testing.dll"
          ]
        }
      ],
      "dest": "artifacts/docs/api",
      "outputFormat": "apiPage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "src": "docs/site", "files": [ "**.md", "**.yml" ], "dest": "." },
      { "src": "artifacts/docs/api", "files": [ "**.yml" ], "dest": "api" },
      { "files": [ "README.md", "CHANGELOG.md", "docs/*.md", "docs/articles/*.md", "docs/articles/toc.yml" ] }
    ],
    "output": "artifacts/docs/_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "ResultUnion",
      "_appTitle": "ResultUnion",
      "_appFooter": "ResultUnion · MIT License",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
