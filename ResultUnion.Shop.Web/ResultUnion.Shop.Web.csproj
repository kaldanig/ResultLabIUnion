<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The shop sample's web front end (README, "A sample with two services"): a Blazor app that calls the orders and
       inventory services with ResultUnion.Http, and shows each failure next to the input it belongs to. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion.Http\ResultUnion.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ResultUnion" />
  </ItemGroup>

</Project>
