<Project>

  <!-- Imported after the project file, so IsPackable is already set. Each packable project ships its own short
       README.md (next to its .csproj) as the package readme, and the repository's LICENSE file. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The public API of each package is recorded in PublicAPI.Shipped.txt (released) and PublicAPI.Unshipped.txt (not
       yet released), next to its .csproj. Adding, changing or removing a public member without updating them is a
       build warning (RS0016, RS0017), so every API change, breaking ones included, shows in the diff. On a release,
       the Unshipped lines move to Shipped. The package adds both files to AdditionalFiles itself when they exist. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package validation: dotnet pack compares each package with the last released version on nuget.org and fails on
       a binary breaking change (CP0002 a removed member, CP0006 a member added to an interface, …). The PublicAPI files
       catch source-level changes while you build; this catches what an already compiled caller would hit, in the
       package as shipped. After a release, set the baseline to the version just published (docs/RELEASING.md).
       A deliberate break before 1.0 is recorded with `dotnet pack -p:GenerateCompatibilitySuppressionFile=true`,
       which writes CompatibilitySuppressions.xml next to the project. -->
  <!-- A package with no API (the template package) sets EnablePackageValidation to false itself. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(EnablePackageValidation)' == ''">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- A package that has never been released sets IsNewPackage; remove it once its first version is on nuget.org. -->
    <PackageValidationBaselineVersion Condition="'$(IsNewPackage)' != 'true'">0.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Every project in this repository runs the ResultUnion analyzers and offers their code fixes, as a package consumer
       would. (The analyzer, code fix and test projects reference them in their own way.) For ResultUnion itself the
       references also make sure both are built before the package that ships them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ResultUnion.Analyzers' and '$(MSBuildProjectName)' != 'ResultUnion.CodeFixes' and '$(MSBuildProjectName)' != 'ResultUnion.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)ResultUnion.Analyzers\ResultUnion.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)ResultUnion.CodeFixes\ResultUnion.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Code coverage for every test project, through Microsoft.Testing.Platform: `dotnet test` with
       `codecoverage.settings.xml` collects it (see docs/RELEASING.md, "Code coverage"). Without those options nothing changes. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <!-- .NET 11 Runtime Async: the runtime suspends and resumes async methods itself instead of compiler-generated
       state machines (cleaner stack traces, less overhead). Only for net11.0 (the netstandard2.0 analyzer is
       excluded). Build with -p:EnableRuntimeAsync=false to compile the classic state machines, as the benchmarks do
       for their comparison job; that build uses its own bin/obj folders (Directory.Build.props), because a change of
       Features alone does not make an incremental build recompile. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(EnableRuntimeAsync)' != 'false'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>
