<Project Sdk="Microsoft.NET.Sdk">

  <!-- Assertions for tests of code that returns results; no test framework dependency. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Test assertions for ResultUnion: ShouldSucceed returns the value, ShouldFail("code") returns the error, ShouldHaveFieldErrors compares every field error, with failure messages that show the whole error. Works with xUnit, NUnit, MSTest and any other test framework.</Description>
    <PackageTags>result;result-pattern;testing;assertions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": a project that installs only this package still gets the ResultUnion analyzers. -->
    <ProjectReference Include="..\ResultUnion\ResultUnion.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
