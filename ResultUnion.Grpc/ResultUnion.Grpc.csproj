<Project Sdk="Microsoft.NET.Sdk">

  <!-- gRPC integration: Error <-> google.rpc.Status / RpcException. Usable on servers and clients; no ASP.NET Core. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>gRPC integration for ResultUnion: Error to and from google.rpc.Status (ErrorInfo, BadRequest, RetryInfo), GetValueOrThrowRpc for services and RpcException.ToError for clients.</Description>
    <PackageTags>result;result-pattern;grpc;rich-error-model;google-rpc-status</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.StatusProto" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion\ResultUnion.csproj" />
  </ItemGroup>

</Project>
