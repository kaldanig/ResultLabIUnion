<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ResultUnion.Http.Tests</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The null-argument contract test, shared with ResultUnion.Tests. -->
    <Compile Include="..\ResultUnion.Tests\Contracts\NullArgumentContract.cs" Link="Contracts\NullArgumentContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server side, for round trips: what ResultUnion.AspNetCore sends, ResultUnion.Http must read back. -->
    <ProjectReference Include="..\ResultUnion.Http\ResultUnion.Http.csproj" />
    <ProjectReference Include="..\ResultUnion.AspNetCore\ResultUnion.AspNetCore.csproj" />
  </ItemGroup>

</Project>
