<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet measurements of ResultUnion: time and allocations of matching, pipelines, failures against
       exceptions, CombineAll and async chains. Run in Release, see docs/BENCHMARKS.md -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- Only for ComparisonBenchmarks: the same use case written with each library. -->
    <PackageReference Include="FluentResults" Version="4.0.0" />
    <PackageReference Include="ErrorOr" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion\ResultUnion.csproj" />
    <ProjectReference Include="..\ResultUnion.Grpc\ResultUnion.Grpc.csproj" />
    <ProjectReference Include="..\ResultUnion.AspNetCore\ResultUnion.AspNetCore.csproj" />
    <ProjectReference Include="..\ResultUnion.Http\ResultUnion.Http.csproj" />
  </ItemGroup>

</Project>
