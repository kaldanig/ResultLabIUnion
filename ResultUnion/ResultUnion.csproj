<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>A Result pattern for .NET built on C# 15 unions: Result&lt;T&gt;, Result and Error with typed categories, railway composition (Map, Bind, Ensure, Tap, Match), async pipelines, CombineAll validation and exception boundaries.</Description>
    <PackageTags>result;result-pattern;railway;union;discriminated-union;error-handling;functional;ddd</PackageTags>
  </PropertyGroup>

  <!-- The analyzers ship in this package, so every project that uses ResultUnion gets them. The analyzer project is
       referenced (and built first) from Directory.Build.targets. -->
  <ItemGroup>
    <None Include="..\ResultUnion.Analyzers\bin\$(Configuration)\netstandard2.0\ResultUnion.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
