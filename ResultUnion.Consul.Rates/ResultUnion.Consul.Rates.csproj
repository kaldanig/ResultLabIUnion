<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Consul sample's exchange-rate service (README, "A sample with HashiCorp Consul"): it registers itself in
       Consul with a TTL check and keeps the check passing while it runs, so the converter finds it by name. Start two of
       them (launch profiles http and http-2) to see the converter go to another instance when one has an outage. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Consul" Version="1.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion.AspNetCore\ResultUnion.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ResultUnion" />
  </ItemGroup>

</Project>
