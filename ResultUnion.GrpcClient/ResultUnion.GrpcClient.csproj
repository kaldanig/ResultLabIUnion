<Project Sdk="Microsoft.NET.Sdk">

  <!-- A gRPC client for ResultUnion.GrpcService. It shares the .proto with the service and turns every RpcException
       back into an Error with ResultUnion.Grpc, so the calling code keeps working with results. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\ResultUnion.GrpcService\Protos\demo.proto" GrpcServices="Client" Link="Protos\demo.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultUnion.Grpc\ResultUnion.Grpc.csproj" />
  </ItemGroup>

</Project>
