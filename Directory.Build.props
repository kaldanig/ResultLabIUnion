<Project>

  <!-- Shared by every project. Only the three libraries are packed: they set IsPackable to true. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- A build without .NET 11 Runtime Async (-p:EnableRuntimeAsync=false, see Directory.Build.targets) gets its own
       output folders, so the two kinds of build never reuse each other's compiled files. Set here because these paths
       must be known before the SDK is imported. They are outside the project folders, so the default globs never pick
       up the other build's generated files. -->
  <PropertyGroup Condition="'$(EnableRuntimeAsync)' == 'false'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\state-machines\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\state-machines\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- The SDK excludes only the current BaseOutputPath/BaseIntermediateOutputPath; keep the regular ones out too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Giorgi Kaldani</Authors>
    <Copyright>Copyright (c) 2026 Giorgi Kaldani</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://kaldanig.github.io/ResultLabIUnion/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kaldanig/ResultLabIUnion.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Source Link and symbols: the .NET SDK adds Source Link for GitHub itself; these make the packages debuggable
       into the exact commit they were built from. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths in the PDBs on CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The package readme is added in Directory.Build.targets, after each project has set IsPackable. -->

</Project>
